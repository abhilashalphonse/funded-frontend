# ACG Funded frontend — local development
# Copy this file to .env and fill in local values.
# Never commit real credentials or secret/service-role keys.

VITE_API_URL=http://localhost:3000

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the browser-safe Supabase publishable/anon key only.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional if the current frontend still uses Finnhub widgets.
VITE_FINNHUB_KEY=
